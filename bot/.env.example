# Telegram Bot Token (向 @BotFather 取得)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Supabase 連線資訊
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 允許的使用者 Telegram ID（逗號分隔，如 5725029188,8514343851；留空則不限制）
ALLOWED_USER_IDS=5725029188,8514343851

# 前端儀表板網址（選填）
DASHBOARD_URL=https://couple-finance.vercel.app

# Google Gemini API Key（用於發票照片辨識）
GEMINI_API_KEY=your_gemini_api_key_here
